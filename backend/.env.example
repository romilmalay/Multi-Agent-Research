# Secrets. Needed for live runs only; the test suite needs none.
OPENAI_API_KEY=
TAVILY_API_KEY=
# Only if LLM__PROVIDER is switched to that provider.
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=

# Any value in research_system/configs/base.yaml can be overridden here.
# Nesting uses a double underscore; unset means the YAML value applies.
LLM__PROVIDER=openai
LLM__MODEL=gpt-4.1-nano
LOGGING__LEVEL=INFO
# PIPELINE__QUALITY_THRESHOLD=0.6
# BUDGET__MAX_TOKENS_PER_RUN=50000
# AGENTS__WRITER__TEMPERATURE=0.5
